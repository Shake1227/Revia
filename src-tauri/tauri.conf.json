{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Revia",
  "version": "0.2.2",
  "identifier": "io.github.shake1227.revia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Revia",
        "width": 1240,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "backgroundColor": "#0a0c13"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://avatars.githubusercontent.com; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "capabilities": [
        "default",
        "window-controls"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Shake_1227",
    "copyright": "Copyright © 2026 Shake_1227",
    "license": "CC-BY-NC-4.0",
    "homepage": "https://github.com/Shake1227/Revia",
    "category": "DeveloperTool",
    "shortDescription": "Scattered projects, one calm workspace.",
    "longDescription": "Revia keeps your local projects and GitHub repositories in one place. See what changed, sync safely, and manage branches without opening each folder.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "icons/dmg/background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 150
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 150
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese",
          "English"
        ],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": [
          "ja-JP",
          "en-US"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "git"
        ],
        "recommends": [
          "gh"
        ],
        "section": "devel"
      },
      "rpm": {
        "depends": [
          "git"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
