{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "window-controls",
  "description": "Windows と Linux では OS の枠を外し、最小化・最大化・閉じるのボタンを Revia が描く。そのボタンに必要な権限。",
  "windows": ["main"],
  "platforms": ["windows", "linux"],
  "permissions": ["core:window:allow-minimize", "core:window:allow-toggle-maximize", "core:window:allow-close"]
}
